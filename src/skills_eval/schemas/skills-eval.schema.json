{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gogoingai/skills-eval/main/src/skills_eval/schemas/skills-eval.schema.json",
  "title": "skills-eval configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": { "const": 1 },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredRootFiles": { "$ref": "#/$defs/stringArray" },
        "requiredSkillFrontmatter": { "$ref": "#/$defs/stringArray" },
        "forbiddenPaths": { "$ref": "#/$defs/stringArray" },
        "referenceExtensions": { "$ref": "#/$defs/stringArray" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failOn": {
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/securitySource" }
        }
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/publishingTarget" },
          "uniqueItems": true
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "versionFile": { "type": "string", "minLength": 1 },
        "requireVersionSemver": { "type": "boolean" },
        "changelogFile": { "type": "string", "minLength": 1 },
        "changelogVersionHeading": { "type": "string", "minLength": 1 },
        "assetReferences": { "$ref": "#/$defs/assetReferences" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": { "enum": ["auto", "zh", "en"] }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "securitySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "enabled"],
      "properties": {
        "name": {
          "enum": ["cisco", "skillspector", "tencent-aig", "snyk"]
        },
        "enabled": { "type": "boolean" },
        "required": { "type": "boolean" },
        "options": { "type": "object" },
        "suppress": {
          "type": "array",
          "description": "Known false-positive rule IDs to exclude from failOn; shown in the report as suppressed.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ruleId"],
            "properties": {
              "ruleId": { "type": "string", "minLength": 1 },
              "reason": { "type": "string" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "name": { "const": "cisco" } }, "required": ["name"] },
          "then": { "properties": { "options": { "$ref": "#/$defs/ciscoOptions" } } }
        },
        {
          "if": { "properties": { "name": { "const": "skillspector" } }, "required": ["name"] },
          "then": { "properties": { "options": { "$ref": "#/$defs/skillspectorOptions" } } }
        },
        {
          "if": { "properties": { "name": { "const": "tencent-aig" } }, "required": ["name"] },
          "then": { "properties": { "options": { "$ref": "#/$defs/tencentAigOptions" } } }
        },
        {
          "if": { "properties": { "name": { "const": "snyk" } }, "required": ["name"] },
          "then": { "properties": { "options": { "$ref": "#/$defs/snykOptions" } } }
        }
      ]
    },
    "ciscoOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": { "enum": ["balanced", "strict", "permissive"] },
        "useBehavioral": { "type": "boolean" }
      }
    },
    "skillspectorOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "useLlm": { "type": "boolean" },
        "executable": { "type": "string", "minLength": 1 }
      }
    },
    "tencentAigOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiKeyEnv": { "type": "string", "minLength": 1 },
        "baseUrlEnv": { "type": "string", "minLength": 1 },
        "modelEnv": { "type": "string", "minLength": 1 },
        "language": { "enum": ["zh", "en"] },
        "executable": { "type": "string", "minLength": 1 },
        "disableThinking": {
          "type": "boolean",
          "description": "Disable DeepSeek V4 thinking mode for faster scans (default true recommended)."
        }
      }
    },
    "snykOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenEnv": { "type": "string", "minLength": 1 },
        "executable": { "type": "string", "minLength": 1 },
        "baseUrl": { "type": "string", "minLength": 1 }
      }
    },
    "publishingTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "enabled"],
      "properties": {
        "name": {
          "enum": ["claude-plugin", "workbuddy", "skillhub", "openclaw", "clawhub"]
        },
        "enabled": { "type": "boolean" },
        "options": { "type": "object" }
      }
    },
    "assetReferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetDirectory", "documentationDirectory", "referencePrefix"],
      "properties": {
        "assetDirectory": { "type": "string", "minLength": 1 },
        "documentationDirectory": { "type": "string", "minLength": 1 },
        "referencePrefix": { "type": "string", "minLength": 1 }
      }
    }
  }
}
